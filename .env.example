# Data source for the UI.
#   true (or unset) -> use the mock in src/data/mockSource.js
#   false           -> call the real backend through src/data/apiSource.js
# Copy this file to .env.local and edit the value there.
VITE_USE_MOCK=true

# Backend address. Leave unset for a backend on this machine.
# Point it at another machine's IP when the backend runs elsewhere:
#   VITE_API_URL=http://192.168.1.42:8081/
# Note: the refresh-token cookie is SameSite=Strict, so sessions expire
# after 15 minutes when the backend is on a different host.
VITE_API_URL=
